# Bind address (0.0.0.0 listens on all interfaces — required so phone can reach the PC)
BIND_ADDR=0.0.0.0

# HTTPS port for the control plane + web UI (phone opens https://<lan-ip>:<HTTPS_PORT>)
HTTPS_PORT=8443

# MediaMTX binary location. Download from https://github.com/bluenviron/mediamtx/releases
# Windows example: C:\\tools\\mediamtx\\mediamtx.exe
MEDIAMTX_PATH=./bin/mediamtx.exe
MEDIAMTX_CONFIG=./media/mediamtx.yml

# MediaMTX ports (must match mediamtx.yml)
WHIP_PORT=8889
RTSP_PORT=8554
RTMP_PORT=1935

# Default stream name used in every URL
STREAM_NAME=live

# Resource budget. Server refuses new sessions when sustained CPU exceeds this.
MAX_CPU_PERCENT=75

# Default codec preference on the phone (h264 | vp9 | av1 | vp8).
DEFAULT_CODEC=h264

# TLS cert & key (created by `npm run certs`)
TLS_CERT=./certs/cert.pem
TLS_KEY=./certs/key.pem

# Senha do painel do operador (vazio = sem autenticacao)
PANEL_PASSWORD=
